# The application is always synthetic in this revision. These control access only.
VELA_DEMO_MODE=1
VELA_DB=runtime/vela.sqlite3
# Set 1 only to enable actual paid calls on synthetic data. Never put keys in browser code.
VELA_ENABLE_CLOUD_MODELS=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Token access behind TLS (VELA_DEMO_MODE=0); provision strong secrets independently.
VELA_PUBLIC_ORIGIN=https://vela.example.org
VELA_PATIENT_TOKEN=
VELA_STAFF_TOKEN=
VELA_OPERATOR_TOKEN=
VELA_RESEARCHER_TOKEN=
VELA_ADMIN_TOKEN=

