{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PainPoint",
  "type": "object",
  "required": ["id", "stakeholder", "source", "normalized_summary", "theme", "score_basis", "source_citations"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "stakeholder": {"enum": ["patient", "nurse", "staff", "physician", "mixed"]},
    "source": {"type": "string"},
    "original_text_if_licensed": {"type": ["string", "null"]},
    "normalized_summary": {"type": "string", "minLength": 1},
    "theme": {"type": "string"},
    "subtheme": {"type": "string"},
    "score_basis": {"const": "product_hypothesis_not_survey_measurement"},
    "frequency_signal": {"$ref": "#/$defs/signal"},
    "severity_signal": {"$ref": "#/$defs/signal"},
    "frustration_signal": {"$ref": "#/$defs/signal"},
    "staff_time_signal": {"$ref": "#/$defs/signal"},
    "workflow_disruption_signal": {"$ref": "#/$defs/signal"},
    "embodiment_value": {"$ref": "#/$defs/signal"},
    "robot_solvability": {"$ref": "#/$defs/signal"},
    "clinical_risk": {"$ref": "#/$defs/signal"},
    "crowded_market_penalty": {"$ref": "#/$defs/signal"},
    "regulatory_complexity": {"$ref": "#/$defs/signal"},
    "patient_autonomy_gain": {"$ref": "#/$defs/signal"},
    "physical_action_required": {"type": ["boolean", "null"]},
    "navigation_required": {"type": ["boolean", "null"]},
    "manipulation_required": {"type": ["boolean", "null"]},
    "conversation_required": {"type": ["boolean", "null"]},
    "information_access_required": {"type": ["boolean", "null"]},
    "estimated_staff_minutes_saved": {"type": ["number", "null"], "minimum": 0},
    "proposed_robot_intervention": {"type": ["string", "null"]},
    "evidence_quality": {"type": "string"},
    "source_citations": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}}
  },
  "$defs": {"signal": {"type": ["number", "null"], "minimum": 0, "maximum": 5}},
  "description": "Weights and scores are product hypotheses. Source reuse, privacy review and measurements require separate validation."
}
